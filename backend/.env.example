# 复制到 .env；使用 scripts/generate_env.py 生成随机凭据，不要直接使用占位符启动。
ADMIN_TOKEN=
READ_TOKEN=
# 可选：普通用户 Token JSON 映射，例如 {"alice":"<至少32字符>"}。
# 这是受控 Token 映射，不是完整账号生命周期体系。
READ_USER_TOKENS=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://knowledge:CHANGE_ME@localhost:5432/knowledge
REDIS_URL=redis://localhost:6379/0
ARCHIVE_ROOT=./storage/archives
INGESTION_ROOT=./storage/ingestion
SOURCE_ROOT=./storage/ingestion
MAX_UPLOAD_BYTES=104857600
MAX_ENTRIES=20000
MAX_FILE_BYTES=20971520
MAX_TOTAL_BYTES=524288000
MAX_COMPRESSION_RATIO=100
MAX_DEPTH=20
JOB_TIMEOUT_SECONDS=300
INDEX_JOB_TIMEOUT_SECONDS=1800
INDEX_QUEUE_NAME=knowledge-index
# worker 使用 index；检索服务使用 SERVICE_MODE=retrieval，由 Compose 设置。
WORKER_KIND=ingestion
SERVICE_MODE=api
DOCUMENTS_ROOT=./storage/documents
STORAGE_CONTROL_ROOT=./storage/.control
STORAGE_QUOTA_BYTES=10737418240
STORAGE_MIN_FREE_BYTES=1073741824
INDEX_MAX_FILE_BYTES=2097152
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_MAX_SEGMENTS=20000
DOCUMENT_MAX_TEXT_CHARS=5000000
SEARCH_TIMEOUT_SECONDS=3
READ_MAX_LINES=200
RETRIEVAL_MAX_CHARS=24000
RETRIEVAL_PORT=8001
# P1.3 仅填写企业批准的OpenAI兼容端点；密钥不进入Git或聊天。
BUILDER_MODEL=
BUILDER_BASE_URL=
BUILDER_API_KEY=
# 独立运维令牌；不得复用管理或只读令牌。生产值仅保存在本机。
MODEL_OPS_TOKEN=
# 明确允许该端点接收的资产类型；默认禁止发送。
BUILDER_ALLOW_SYNTHETIC=false
BUILDER_ALLOW_ENTERPRISE=false
BUILDER_INPUT_USD_PER_MILLION=
BUILDER_OUTPUT_USD_PER_MILLION=
BUILDER_MAX_REQUESTS=8
BUILDER_MAX_TOOL_CALLS=30
BUILDER_MAX_TOKENS=30000
BUILDER_MAX_CONTEXT_CHARS=80000
BUILDER_MAX_MODULES=24
BUILDER_MODULE_TIMEOUT_SECONDS=180
BUILDER_JOB_TIMEOUT_SECONDS=1800
BUILDER_MAX_OUTPUT_TOKENS=4000
# 空值使用供应商默认；仅配置模型支持的low/high，GLM-5.3-Flash本批使用low。
BUILDER_REASONING_EFFORT=
BUILDER_QUEUE_NAME=knowledge-builder
